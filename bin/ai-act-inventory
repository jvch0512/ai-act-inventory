#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
import aia  # noqa: E402


def usage():
    sys.stderr.write("usage: ai-act-inventory PATH [--tsv] [--fail-on medium|high|critical]\n"
                     "Exit: 0 ok, 1 findings at or above --fail-on, 2 bad input.\n")
    return 2


def main(argv):
    path, tsv, fail_on = None, False, None
    a = list(argv)
    while a:
        x = a.pop(0)
        if x == "--tsv":
            tsv = True
        elif x == "--fail-on":
            if not a or a[0] not in ("medium", "high", "critical"):
                return usage()
            fail_on = a.pop(0)
        elif x.startswith("-") or path is not None:
            return usage()
        else:
            path = x
    if path is None:
        return usage()
    if not os.path.exists(path):
        sys.stderr.write(f"error: no such file or directory: {path}\n")
        return 2
    files = []
    if os.path.isdir(path):
        base = path.rstrip("/") or "/"
        for n in sorted(os.listdir(base)):
            p = os.path.join(base, n)
            if n.endswith(".csv") and os.path.isfile(p) and not os.path.islink(p):
                files.append((n, p))
    else:
        files.append((os.path.basename(path), path))
    allf = []
    for label, p in files:
        try:
            if os.path.getsize(p) > 20_000_000:
                continue
            with open(p, "rb") as fh:
                text = fh.read().decode("utf-8", "replace")
        except OSError:
            continue
        allf.extend(aia.audit(text, label))
    allf = aia.sort_findings(allf)
    head = f"{len(files)} files, {len(allf)} findings"
    out = ["# " + head if tsv else head]
    for f in allf:
        if tsv:
            out.append("\t".join([f["sev"], f["rule"], f["where"], f["msg"]]))
        else:
            out.append(f"{f['sev'].upper():<8} {f['rule']} {f['where']}")
            out.append("         " + f["msg"])
    sys.stdout.write("\n".join(out) + "\n")
    if fail_on and any(aia.RANK[f["sev"]] <= aia.RANK[fail_on] for f in allf):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
